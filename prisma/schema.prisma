generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                           String                @id @default(cuid())
  firstName                    String
  lastName                     String
  email                        String                @unique
  phone                        String?
  source                       String                @default("Unknown")
  sourcePage                   String?
  resendContactId              String?               @unique
  resendAudienceId             String?
  resendTags                   String[]              @default([])
  automationEnrolled           Boolean               @default(false)
  automationName               String?
  automationStartedAt          DateTime?
  automationCompletedAt        DateTime?
  emailsReceived               Int                   @default(0)
  emailsOpened                 Int                   @default(0)
  emailsClicked                Int                   @default(0)
  lastEmailOpenedAt            DateTime?
  lastEmailClickedAt           DateTime?
  skoolMemberId                String?               @unique
  skoolPlan                    String?
  skoolMembershipStartedAt     DateTime?
  skoolWelcomeEmailSent        Boolean               @default(false)
  skoolWelcomeEmailSentAt      DateTime?
  fullSimulatorResultsUnlocked Boolean               @default(false)
  officialCashFlowVisionary    Boolean               @default(false)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @default(now()) @updatedAt
  syncedToGlobalControl        Boolean               @default(false)
  globalControlContactId       String?
  emailEvents                  EmailEvent[]
  simulatorResults             SimulatorResult[]
  skoolEvents                  SkoolEvent[]
  webinarJamEvents             WebinarJamEvent[]
  webinarRegistrations         WebinarRegistration[]
  automationEnrollments        AutomationEnrollment[]
  scheduledEmails              ScheduledEmail[]

  @@index([email])
  @@index([createdAt])
  @@index([sourcePage])
  @@index([resendContactId])
  @@index([resendAudienceId])
}

model SimulatorResult {
  id                         String    @id @default(cuid())
  leadId                     String
  selectedPurposes           String[]
  monthlyGoal                Float
  enterpriseConnections      Int
  enterpriseResidualCashFlow Float
  communityCompoundingWeek   Float
  simulatorStarted           Boolean   @default(true)
  simulatorCompleted         Boolean   @default(false)
  completedAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  lead                       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([simulatorCompleted])
  @@index([createdAt])
}

model ResendAudience {
  id           String   @id @default(cuid())
  resendId     String   @unique
  name         String
  description  String?
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([resendId])
}

model ResendAutomation {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  triggerType    String
  triggerValue   String?
  audienceId     String?
  fromDomain     String   @default("m.networkleveragingcashflow.com")
  fromName       String   @default("Network Leveraging Cash Flow")
  fromEmail      String?
  active         Boolean  @default(true)
  emails         Json
  enrolledCount  Int      @default(0)
  completedCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([active])
}

model ResendBroadcast {
  id             String    @id @default(cuid())
  name           String
  subject        String
  htmlContent    String
  textContent    String?
  audienceId     String?
  tags           String[]  @default([])
  fromDomain     String    @default("m.networkleveragingcashflow.com")
  fromName       String    @default("Network Leveraging Cash Flow")
  fromEmail      String?
  scheduledFor   DateTime?
  sentAt         DateTime?
  status         String    @default("draft")
  recipientCount Int       @default(0)
  openedCount    Int       @default(0)
  clickedCount   Int       @default(0)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([sentAt])
}

model EmailEvent {
  id           String   @id @default(cuid())
  leadId       String
  eventType    String
  emailId      String?
  broadcastId  String?
  automationId String?
  metadata     Json?
  occurredAt   DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([eventType])
  @@index([occurredAt])
}

model SkoolEvent {
  id               String    @id @default(cuid())
  leadId           String?
  eventType        String
  skoolMemberId    String?
  skoolEmail       String?
  rawPayload       Json
  membershipPlan   String?
  membershipStatus String?
  processed        Boolean   @default(false)
  processedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  lead             Lead?     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([eventType])
  @@index([skoolMemberId])
  @@index([skoolEmail])
  @@index([createdAt])
}

model WebinarEvent {
  id                   String                @id @default(cuid())
  webinarId            String                @unique
  name                 String
  description          String?
  startDateTime        DateTime
  timezone             String                @default("America/New_York")
  durationMinutes      Int                   @default(60)
  webinarJamWebinarId  Int
  webinarJamScheduleId Int
  webinarJamHash       String
  qualificationMethod  String
  requiredSkoolPlan    String?
  skoolPlansUrl        String?
  registrationPageUrl  String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  registrations        WebinarRegistration[]

  @@index([webinarId])
  @@index([active])
  @@index([startDateTime])
}

model WebinarRegistration {
  id                      String       @id @default(cuid())
  leadId                  String
  webinarEventId          String
  source                  String
  campaign                String?
  leadCapturedAt          DateTime     @default(now())
  qualificationMethod     String
  qualifiedAt             DateTime?
  webinarEligible         Boolean      @default(false)
  webinarEligibleSince    DateTime?
  webinarJamRegistrantId  String?
  webinarJamLiveRoomUrl   String?
  webinarJamReplayRoomUrl String?
  registeredAt            DateTime?
  registrationStatus      String       @default("pending")
  registrationError       String?
  registrationAttempts    Int          @default(0)
  lastAttemptAt           DateTime?
  attended                Boolean      @default(false)
  attendedAt              DateTime?
  attendanceDuration      Int?
  leftEarly               Boolean      @default(false)
  replayViewed            Boolean      @default(false)
  replayViewedAt          DateTime?
  status                  String       @default("lead_captured")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  lead                    Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  webinarEvent            WebinarEvent @relation(fields: [webinarEventId], references: [id], onDelete: Cascade)

  @@unique([leadId, webinarEventId])
  @@index([leadId])
  @@index([webinarEventId])
  @@index([status])
  @@index([webinarEligible])
  @@index([attended])
}

model WebinarJamEvent {
  id                    String    @id @default(cuid())
  leadId                String?
  compositeKey          String?   @unique
  trigger               String
  webinarJamWebinarId   Int?
  webinarJamWebinarName String?
  email                 String
  firstName             String?
  lastName              String?
  phoneCountryCode      String?
  phoneNumber           String?
  liveRoomUrl           String?
  replayRoomUrl         String?
  unsubscribeUrl        String?
  attendanceDuration    Int?
  rawPayload            Json
  processed             Boolean   @default(false)
  processedAt           DateTime?
  errorMessage          String?
  receivedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  lead                  Lead?     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([trigger])
  @@index([email])
  @@index([processed])
  @@index([receivedAt])
}

model GlobalControlOutbox {
  id            String    @id @default(cuid())
  tagName       String
  email         String
  firstName     String?
  lastName      String?
  phone         String?
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([email, tagName])
}

// Automation Enrollment Tracking
model AutomationEnrollment {
  id               String    @id @default(cuid())
  leadId           String
  automationId     String
  enrolledAt       DateTime  @default(now())
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  currentEmailIndex Int      @default(0)
  status           String    @default("active") // active, completed, cancelled
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, automationId])
  @@index([leadId])
  @@index([automationId])
  @@index([status])
  @@index([enrolledAt])
}

// Scheduled Email Queue
model ScheduledEmail {
  id               String    @id @default(cuid())
  leadId           String
  automationId     String
  enrollmentId     String
  emailIndex       Int
  subject          String
  htmlContent      String
  textContent      String?
  fromDomain       String
  fromName         String
  fromEmail        String
  scheduledFor     DateTime
  sentAt           DateTime?
  resendId         String?
  status           String    @default("pending") // pending, sent, failed, cancelled
  errorMessage     String?
  retryCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([automationId])
  @@index([enrollmentId])
  @@index([status])
  @@index([scheduledFor])
  @@index([sentAt])
}
