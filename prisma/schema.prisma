generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AutomationEnrollment {
  id             String           @id
  leadId         String
  automationId   String
  status         String           @default("active")
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  metadata       Json?
  Lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ScheduledEmail ScheduledEmail[]

  @@unique([leadId, automationId])
  @@index([automationId])
  @@index([leadId])
  @@index([status])
}

model EmailEvent {
  id           String   @id
  leadId       String
  eventType    String
  emailId      String?
  broadcastId  String?
  automationId String?
  metadata     Json?
  occurredAt   DateTime @default(now())
  Lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([leadId])
  @@index([occurredAt])
}

model GlobalControlOutbox {
  id            String    @id
  tagName       String
  email         String
  firstName     String?
  lastName      String?
  phone         String?
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([email, tagName])
  @@index([status])
}

model Lead {
  id                           String                 @id
  firstName                    String
  lastName                     String
  email                        String                 @unique
  phone                        String?
  source                       String                 @default("Unknown")
  sourcePage                   String?
  resendContactId              String?                @unique
  resendAudienceId             String?
  resendTags                   String[]               @default([])
  automationEnrolled           Boolean                @default(false)
  automationName               String?
  automationStartedAt          DateTime?
  automationCompletedAt        DateTime?
  emailsReceived               Int                    @default(0)
  emailsOpened                 Int                    @default(0)
  emailsClicked                Int                    @default(0)
  lastEmailOpenedAt            DateTime?
  lastEmailClickedAt           DateTime?
  skoolMemberId                String?                @unique
  skoolPlan                    String?
  skoolMembershipStartedAt     DateTime?
  fullSimulatorResultsUnlocked Boolean                @default(false)
  officialCashFlowVisionary    Boolean                @default(false)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @default(now())
  syncedToGlobalControl        Boolean                @default(false)
  globalControlContactId       String?
  skoolWelcomeEmailSent        Boolean                @default(false)
  skoolWelcomeEmailSentAt      DateTime?
  AutomationEnrollment         AutomationEnrollment[]
  EmailEvent                   EmailEvent[]
  ScheduledEmail               ScheduledEmail[]
  SimulatorResult              SimulatorResult[]
  SkoolEvent                   SkoolEvent[]
  WebinarJamEvent              WebinarJamEvent[]
  WebinarRegistration          WebinarRegistration[]

  @@index([createdAt])
  @@index([email])
  @@index([resendAudienceId])
  @@index([resendContactId])
  @@index([sourcePage])
}

model ResendAudience {
  id           String   @id
  resendId     String   @unique
  name         String
  description  String?
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([resendId])
}

model ResendAutomation {
  id             String   @id
  name           String   @unique
  description    String?
  triggerType    String
  triggerValue   String?
  audienceId     String?
  fromDomain     String   @default("m.networkleveragingcashflow.com")
  fromName       String   @default("Network Leveraging Cash Flow")
  fromEmail      String?
  active         Boolean  @default(true)
  emails         Json
  enrolledCount  Int      @default(0)
  completedCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([active])
  @@index([name])
}

model ResendBroadcast {
  id             String    @id
  name           String
  subject        String
  htmlContent    String
  textContent    String?
  audienceId     String?
  tags           String[]  @default([])
  fromDomain     String    @default("m.networkleveragingcashflow.com")
  fromName       String    @default("Network Leveraging Cash Flow")
  fromEmail      String?
  scheduledFor   DateTime?
  sentAt         DateTime?
  status         String    @default("draft")
  recipientCount Int       @default(0)
  openedCount    Int       @default(0)
  clickedCount   Int       @default(0)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime

  @@index([scheduledFor])
  @@index([sentAt])
  @@index([status])
}

model ScheduledEmail {
  id                   String               @id
  enrollmentId         String
  leadId               String
  automationId         String
  emailIndex           Int
  subject              String
  htmlContent          String
  textContent          String
  scheduledFor         DateTime
  status               String               @default("pending")
  sentAt               DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  fromDomain           String
  fromName             String
  replyTo              String
  resendMessageId      String?
  retryCount           Int                  @default(0)
  lastError            String?
  createdAt            DateTime             @default(now())
  AutomationEnrollment AutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  Lead                 Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([enrollmentId])
  @@index([leadId])
  @@index([scheduledFor])
  @@index([status])
}

model SimulatorResult {
  id                         String    @id
  leadId                     String
  selectedPurposes           String[]
  monthlyGoal                Float
  enterpriseConnections      Int
  enterpriseResidualCashFlow Float
  communityCompoundingWeek   Float
  simulatorStarted           Boolean   @default(true)
  simulatorCompleted         Boolean   @default(false)
  completedAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime
  matchedTierGoal            Float?
  Lead                       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([leadId])
  @@index([simulatorCompleted])
}

model SkoolEvent {
  id               String    @id
  leadId           String?
  eventType        String
  skoolMemberId    String?
  skoolEmail       String?
  rawPayload       Json
  membershipPlan   String?
  membershipStatus String?
  processed        Boolean   @default(false)
  processedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  Lead             Lead?     @relation(fields: [leadId], references: [id])

  @@index([createdAt])
  @@index([eventType])
  @@index([leadId])
  @@index([skoolEmail])
  @@index([skoolMemberId])
}

model WebinarEvent {
  id                   String                @id
  webinarId            String                @unique
  name                 String
  description          String?
  startDateTime        DateTime
  timezone             String                @default("America/New_York")
  durationMinutes      Int                   @default(60)
  webinarJamWebinarId  Int
  webinarJamScheduleId Int
  webinarJamHash       String
  qualificationMethod  String
  requiredSkoolPlan    String?
  skoolPlansUrl        String?
  registrationPageUrl  String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  WebinarRegistration  WebinarRegistration[]

  @@index([active])
  @@index([startDateTime])
  @@index([webinarId])
}

model WebinarJamEvent {
  id                    String    @id
  leadId                String?
  compositeKey          String?   @unique
  trigger               String
  webinarJamWebinarId   Int?
  webinarJamWebinarName String?
  email                 String
  firstName             String?
  lastName              String?
  phoneCountryCode      String?
  phoneNumber           String?
  liveRoomUrl           String?
  replayRoomUrl         String?
  unsubscribeUrl        String?
  attendanceDuration    Int?
  rawPayload            Json
  processed             Boolean   @default(false)
  processedAt           DateTime?
  errorMessage          String?
  receivedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  Lead                  Lead?     @relation(fields: [leadId], references: [id])

  @@index([email])
  @@index([leadId])
  @@index([processed])
  @@index([receivedAt])
  @@index([trigger])
}

model WebinarRegistration {
  id                      String       @id
  leadId                  String
  webinarEventId          String
  source                  String
  campaign                String?
  leadCapturedAt          DateTime     @default(now())
  qualificationMethod     String
  qualifiedAt             DateTime?
  webinarEligible         Boolean      @default(false)
  webinarEligibleSince    DateTime?
  webinarJamRegistrantId  String?
  webinarJamLiveRoomUrl   String?
  webinarJamReplayRoomUrl String?
  registeredAt            DateTime?
  registrationStatus      String       @default("pending")
  registrationError       String?
  registrationAttempts    Int          @default(0)
  lastAttemptAt           DateTime?
  attended                Boolean      @default(false)
  attendedAt              DateTime?
  attendanceDuration      Int?
  leftEarly               Boolean      @default(false)
  replayViewed            Boolean      @default(false)
  replayViewedAt          DateTime?
  status                  String       @default("lead_captured")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime
  Lead                    Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  WebinarEvent            WebinarEvent @relation(fields: [webinarEventId], references: [id], onDelete: Cascade)

  @@unique([leadId, webinarEventId])
  @@index([attended])
  @@index([leadId])
  @@index([status])
  @@index([webinarEligible])
  @@index([webinarEventId])
}
