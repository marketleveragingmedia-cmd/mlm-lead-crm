# Production Environment Variables for Webinar Infrastructure
# DO NOT commit actual secrets to Git

# WebinarJam API Key (ROTATE - DO NOT use the key from verification images)
WEBINARJAM_API_KEY=your_rotated_production_key_here

# WebinarJam Webhook Secret (Generate new)
WEBINARJAM_WEBHOOK_SECRET=$(openssl rand -base64 32)

# Database (already configured in Vercel)
DATABASE_URL=your_database_url

# Global Control (already configured)
GLOBAL_CONTROL_API_KEY=your_gc_api_key

# Skooly (already configured)
SKOOLY_SECRET=your_skooly_secret
