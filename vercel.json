{
  "crons": [
    {
      "path": "/api/cron/process-scheduled-emails",
      "schedule": "0 */1 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/cash-flow-injection-masterclass",
      "has": [
        {
          "type": "host",
          "value": "masterclass.cashflowvisionaries.com"
        }
      ],
      "permanent": false
    }
  ]
}
