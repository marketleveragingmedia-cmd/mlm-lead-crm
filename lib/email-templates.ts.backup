// Email Template Library
// Reusable HTML email templates for the Resend CRM system

export interface EmailTemplate {
  id: string;
  name: string;
  description: string;
  subject: string;
  html: string;
  category: 'welcome' | 'nurture' | 'engagement' | 'announcement';
}

// Base email wrapper with brand colors
export function wrapEmailContent(content: string, fromName: string = 'Network Leveraging Cash Flow'): string {
  return `
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; background: #f5f5f5; }
    .container { max-width: 600px; margin: 0 auto; background: white; }
    .header { background: linear-gradient(135deg, #1E8E5A 0%, #166B44 100%); padding: 32px 24px; text-align: center; }
    .header h1 { color: white; margin: 0; font-size: 24px; font-weight: 700; }
    .content { padding: 32px 24px; }
    .button { display: inline-block; background: #1E8E5A; color: white; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; margin: 16px 0; }
    .footer { background: #f9f9f9; padding: 24px; text-align: center; font-size: 13px; color: #666; border-top: 1px solid #e5e5e5; }
    .gold { color: #C9A441; }
    .green { color: #1E8E5A; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>${fromName}</h1>
    </div>
    <div class="content">
      ${content}
    </div>
    <div class="footer">
      <p>You're receiving this because you signed up for updates from ${fromName}.</p>
      <p style="margin-top: 16px;">
        <a href="{{unsubscribe_url}}" style="color: #666; text-decoration: underline;">Unsubscribe</a>
      </p>
    </div>
  </div>
</body>
</html>
  `.trim();
}

